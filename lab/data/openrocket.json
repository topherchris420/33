 "lab_observations": [
  {
   "id": "LAB-OBS-1",
   "status": "candidate for human review; not entered in the discrepancy register",
   "title": "Fin root leading-edge station: static-margin parser versus OpenRocket axial semantics",
   "detail": "The largest-span fin set is positioned with method 'bottom' and offset 0.0 m in its parent tube. OpenRocket places a 'bottom'-referenced component so that its aft end aligns with the parent's aft end, which puts the root leading edge at 0.471 m from the nose tip. Simulation/static_margin.py reads the <position> value without its type attribute and records X_f = 0.381 m in docs/EVIDENCE/C5_static_margin_inputs.json.",
   "values_m": {
    "ork_semantics": 0.471,
    "static_margin_inputs_X_f": 0.381,
    "difference": 0.09
   },
   "not_computed": "The effect on either centre-of-pressure formulation is not computed here; doing so would be a third model. It needs a reviewed model change.",
   "sources": [
    "Simulation/Folding Stabilized Rocket.ork",
    "Simulation/static_margin.py",
    "docs/EVIDENCE/C5_static_margin_inputs.json"
   ],
   "related": [
    "C5",
    "D-006",
    "D-008"
   ]
  }
 ],
 "semantics_note": "Stations are distances from the nose tip. Body components stack in document order; attached components use their axial method (top, middle, bottom, absolute) relative to the parent, as OpenRocket defines them. Override masses and materials are simulation inputs, not measurements."
}
