{
  "name": "Project33Protocol",
  "firmware_constants": {
    "READY": "READY",
    "IGNITED": "IGNITED",
    "CMD_ARM": "ARM",
    "CMD_IGNITE": "IGNITE",
    "CMD_CALIBRATE": "CALIBRATE",
    "CMD_DUMPLOG": "DUMPLOG",
    "DASHBOARD_LAUNCH": "launch",
    "DASHBOARD_CALIBRATE": "calibrate",
    "DASHBOARD_DUMPLOG": "dumplog",
    "DATA_PREFIX": "DATA,",
    "STATUS_PREFIX": "STATUS:",
    "ENV_PREFIX": "ENV,",
    "LOG_PREFIX": "LOG",
    "LOG_START": "LOG_START",
    "LOG_END": "LOG_END",
    "CMD_ACK_LAUNCH_READY": "CMD_ACK:launch_ready",
    "CMD_REJECT_LAUNCH_NOT_READY": "CMD_REJECT:launch_not_ready",
    "CMD_REJECT_DASHBOARD_LAUNCH_DISABLED": "CMD_REJECT:dashboard_launch_disabled",
    "CMD_REJECT_PID_INVALID": "CMD_REJECT:pid_invalid",
    "CMD_REJECT_UNKNOWN_COMMAND": "CMD_REJECT:unknown_command",
    "ABORT_PREFIX": "ABORT:",
    "CMD_REJECT_ARM_NOT_IDLE": "CMD_REJECT:arm_not_idle",
    "CMD_REJECT_IGNITE_NOT_ARMED": "CMD_REJECT:ignite_not_armed",
    "CMD_REJECT_IGNITE_FINS_NOT_DEPLOYED": "CMD_REJECT:ignite_fins_not_deployed",
    "CMD_REJECT_SENSOR_UNAVAILABLE": "CMD_REJECT:sensor_unavailable"
  },
  "messages": [
    {
      "direction": "Rocket -> Launcher",
      "format": "READY",
      "purpose": "Rocket idle heartbeat"
    },
    {
      "direction": "Rocket -> Launcher",
      "format": "IGNITED",
      "purpose": "Rocket-side ignition acknowledgement"
    },
    {
      "direction": "Rocket -> Launcher",
      "format": "DATA,<ax>,<ay>,<az>,<roll>,<rate>,<output>,<state>,<Kp>,<Kd>,<skew>",
      "purpose": "Live rocket telemetry packet"
    },
    {
      "direction": "Rocket -> Launcher",
      "format": "LOG,<ms>,<roll>,<rate>,<output>,<state>,<Kp>,<Kd>,<skew>",
      "purpose": "Onboard ring-buffer log dump sample"
    },
    {
      "direction": "Launcher -> Rocket",
      "format": "ARM",
      "purpose": "Arm rocket flight computer"
    },
    {
      "direction": "Launcher -> Rocket",
      "format": "IGNITE",
      "purpose": "Start rocket ignition state"
    },
    {
      "direction": "Launcher -> Rocket",
      "format": "DUMPLOG",
      "purpose": "Request rocket onboard ring-buffer dump"
    },
    {
      "direction": "Dashboard -> Launcher",
      "format": "dumplog",
      "purpose": "Ask launcher to request rocket onboard log dump"
    },
    {
      "direction": "Launcher -> Dashboard",
      "format": "CMD_REJECT:launch_not_ready",
      "purpose": "Dashboard launch command rejected outside READY"
    },
    {
      "direction": "Launcher -> Dashboard",
      "format": "CMD_REJECT:dashboard_launch_disabled",
      "purpose": "Dashboard launch command rejected because remote launch is disabled in firmware"
    },
    {
      "direction": "Launcher -> Dashboard",
      "format": "CMD_REJECT:pid_invalid",
      "purpose": "Dashboard PID command rejected because values were malformed or outside the allowed range"
    },
    {
      "direction": "Launcher -> Dashboard",
      "format": "CMD_REJECT:unknown_command",
      "purpose": "Dashboard command was not recognized by the launcher"
    },
    {
      "direction": "Launcher -> Rocket",
      "format": "CALIBRATE",
      "purpose": "Re-zero the gyro offset; the rocket sends no acknowledgement"
    },
    {
      "direction": "Launcher -> Rocket",
      "format": "PID,<Kp>,<Kd>",
      "purpose": "Set controller gains (each 0-10); invalid values return CMD_REJECT:pid_invalid"
    },
    {
      "direction": "Rocket -> Launcher",
      "format": "LOG_START,<count> ... LOG_END",
      "purpose": "Bracket an onboard log dump so a partial dump is detectable"
    },
    {
      "direction": "Rocket -> Launcher -> Dashboard",
      "format": "CMD_REJECT:arm_not_idle",
      "purpose": "ARM refused because the rocket is not IDLE"
    },
    {
      "direction": "Rocket -> Launcher -> Dashboard",
      "format": "CMD_REJECT:ignite_not_armed",
      "purpose": "IGNITE refused because the rocket is not ARMED"
    },
    {
      "direction": "Rocket -> Launcher -> Dashboard",
      "format": "CMD_REJECT:ignite_fins_not_deployed",
      "purpose": "IGNITE refused because the deploy flag is not set (see discrepancy D-017)"
    },
    {
      "direction": "Rocket -> Launcher -> Dashboard",
      "format": "CMD_REJECT:sensor_unavailable",
      "purpose": "ARM or IGNITE refused because the MPU6050 is unavailable"
    },
    {
      "direction": "Launcher -> Dashboard",
      "format": "T,<launcher_ms>,<roll>,<rate>,<output>",
      "purpose": "Live sample relayed from a DATA line; the time is the launcher's millis() at relay, not the rocket's sample time"
    },
    {
      "direction": "Launcher -> Dashboard",
      "format": "STATUS:<state>,<Kp>,<Kd>,<skew>",
      "purpose": "Rocket state and active gains, sent after each T packet"
    },
    {
      "direction": "Launcher -> Dashboard",
      "format": "ENV,<lat>,<lon>,<alt>,<gps_state>",
      "purpose": "Launcher environment; lat/lon are 0.0 placeholders unless gps_state is 2; alt is nan when the barometer is unavailable"
    },
    {
      "direction": "Launcher -> Dashboard",
      "format": "ABORT:<reason>",
      "purpose": "Launcher abort reason (switch reset, rocket timeout, heartbeat loss, missing IGNITED ack)"
    }
  ]
}
